namespace sentinel;

enum Emotion : byte {
    Neutral = 0,
    Happy = 1,
    Frustrated = 2,
    Stressed = 3,
    Relaxed = 4,
    Excited = 5,
    Bored = 6,
    Anxious = 7,
    Focused = 8,
    Tired = 9,
}

table BioStateUpdate {
    agent_id: uint16;
    hunger: float;
    energy: float;
    caffeine_mg: float;
    bladder: float;
    stress: float;
    social_need: float;
    comfort: float;
    timestamp: uint64;
    tick: uint64;
}

table PositionUpdate {
    agent_id: uint16;
    room_id: uint16;
    in_transit: bool;
    transit_target: uint16;
    timestamp: uint64;
    tick: uint64;
}

table MoodUpdate {
    agent_id: uint16;
    valence: float;
    arousal: float;
    dominant_emotion: Emotion;
    timestamp: uint64;
    tick: uint64;
}

root_type BioStateUpdate;
