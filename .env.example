# Sentinel Environment Configuration — Template
#
# Copy to .env (which is gitignored) and adjust values for your environment.
# .env.example is tracked as a documentation reference.

# Deploy VM hostname or IP
# Set SENTINEL_DEPLOY_SSH_ALIAS privately for benchmark SSH and scp examples.
SENTINEL_VM_IP=192.0.2.240

# Build server (used only for cargo remote --)
SENTINEL_BUILD_SERVER=192.0.2.155

# Test target (defaults to loopback)
SENTINEL_TEST_VM=127.0.0.1
SENTINEL_VM_HOST=127.0.0.1

# Additional DNS names and IPs for the generated dashboard certificate
# SENTINEL_DASHBOARD_TLS_NAMES=dashboard.example.invalid,192.0.2.10

# Live acceptance only. Load the actual endpoints from private infrastructure config.
# BASE_URL=https://dashboard.example.invalid:8001
# SENTINEL_LIVE_HTTP_ORIGIN=https://dashboard.example.invalid:8001
# SENTINEL_LIVE_WT_URL=https://dashboard.example.invalid:8001
# Load DASHBOARD_KEY, SENTINEL_LIVE_CERT_HASH_B64 and SENTINEL_LIVE_SESSION_COOKIE
# separately from deployment-specific configuration.

# NTFY notification server (deploy/scripts/sentinel-health-monitor.sh)
# Optional shared endpoint. Keep the actual endpoint and topics in private configuration.
NTFY_SERVER=
# NTFY_TOPIC=sentinel-health
# For a private TLS CA, provide its trusted certificate bundle on the service host.
NTFY_CA_FILE=

# CodeQL build hints (Phase 12b)
# Set if dashboard build needs different flags than default
# DASHBOARD_BUILD_FLAGS=
