# Sentinel Environment Configuration — Template
#
# Copy to .env (which is gitignored) and adjust values for your environment.
# .env.example is tracked as a documentation reference.

# Deploy VM hostname or IP
SENTINEL_VM_IP=192.0.2.240

# Build server (used only for cargo remote --)
SENTINEL_BUILD_SERVER=192.0.2.155

# Test target (defaults to loopback)
SENTINEL_TEST_VM=127.0.0.1
SENTINEL_VM_HOST=127.0.0.1

# NTFY notification server (deploy/scripts/sentinel-health-monitor.sh)
NTFY_SERVER=https://ntfy.sh

# CodeQL build hints (Phase 12b)
# Set if dashboard build needs different flags than default
# DASHBOARD_BUILD_FLAGS=
