{
  "type": "object",
  "properties": {
    "schema_version": { "type": "integer", "enum": [3] },
    "decision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "enum": ["defer_budget"] },
            "rationale": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "\\S" },
            "evidence_refs": { "type": "array", "minItems": 1, "maxItems": 8, "description": "Use unique evidence references supplied in context.", "items": { "type": "string" } }
          },
          "required": ["kind", "rationale", "evidence_refs"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "type": "string", "enum": ["continue"] },
            "additional_model_calls": { "type": "integer", "minimum": 1, "maximum": 64 },
            "window_ms": { "type": "integer", "minimum": 1000, "maximum": 300000 },
            "rationale": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "\\S" },
            "evidence_refs": { "type": "array", "minItems": 1, "maxItems": 8, "description": "Use unique evidence references supplied in context.", "items": { "type": "string" } }
          },
          "required": ["kind", "additional_model_calls", "window_ms", "rationale", "evidence_refs"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["schema_version", "decision"],
  "additionalProperties": false
}
