[Unit]
Description=Sentinel NATS Bridge — Limbo EventStore to NATS JetStream
Documentation=https://github.com/silentspike/project-sentinel/issues/26
After=nats-server.service sentinel-daemon.service
Requires=nats-server.service
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
WorkingDirectory=/opt/sentinel
ExecStart=/opt/sentinel/bin/sentinel-nats-bridge
Restart=on-failure
RestartSec=5
MemoryMax=256M
Environment=SENTINEL_BRIDGE_CONFIG=/opt/sentinel/config/nats-bridge.toml
# #525: loopback-only secure default for the health endpoint (:8083). The bind
# address is set via [server] health_bind_addr in nats-bridge.toml (loopback by
# default). Deliberate exposure = override health_bind_addr there; do NOT re-add
# a 0.0.0.0/wildcard bind. Consistent with the dashboard-backend posture (#474).

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sentinel-nats-bridge

# Security Hardening
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/opt/sentinel/data

[Install]
WantedBy=sentinel.target
