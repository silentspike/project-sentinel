[Unit]
Description=Sentinel Projection Worker — CQRS Read-Model Service
Documentation=https://github.com/silentspike/project-sentinel/issues/53
# The daemon's ExecStartPost requires projection-backed runtime readiness. Keep
# lifecycle coupling through Requires, but start both units concurrently so the
# projection can converge while the daemon is still activating.
Requires=sentinel-daemon.service
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/sentinel
ExecStart=/opt/sentinel/bin/sentinel-projection \
  --event-store /opt/sentinel/data/events.db \
  --projection-db /opt/sentinel/data/projection.db
Restart=always
RestartSec=5
MemoryMax=512M

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sentinel-projection

# Security Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/sentinel/data
PrivateTmp=true

[Install]
WantedBy=sentinel.target
