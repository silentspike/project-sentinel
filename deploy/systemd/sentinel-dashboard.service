[Unit]
Description=Sentinel Dashboard — Web UI + WebSocket
Documentation=https://github.com/silentspike/project-sentinel/issues/28
After=sentinel-gateway.service
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
WorkingDirectory=/opt/sentinel/dashboard
ExecStart=/usr/local/bin/bun run start
Environment=PORT=8000
Environment=PROJECTION_DB_PATH=/opt/sentinel/data/projection.db
Environment=EVENT_STORE_DB_PATH=/opt/sentinel/data/events.db
Restart=on-failure
RestartSec=5
MemoryMax=512M

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sentinel-dashboard

# Security Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/sentinel/dashboard
PrivateTmp=true

[Install]
WantedBy=sentinel.target
