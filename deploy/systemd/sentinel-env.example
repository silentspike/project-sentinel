# Sentinel systemd Environment File — Template
#
# Deploy as /etc/sentinel/env on the deploy VM. Referenced from systemd units
# via `EnvironmentFile=/etc/sentinel/env`.
# This .example is tracked; the actual /etc/sentinel/env is host-local.

# Production VM internal IP/hostname (used for service discovery if needed)
SENTINEL_VM_IP=192.0.2.240

# NATS endpoint (leave default if NATS runs on same host)
NATS_URL=nats://127.0.0.1:4222

# Cortex Gateway upstream (typically same host)
CORTEX_GATEWAY_URL=http://127.0.0.1:8080

# Anthropic API key (required for cortex-gateway with claude provider)
# ANTHROPIC_API_KEY=

# Logging
RUST_LOG=info

# OTLP tracing (default off). `sentinel-daemon` is wired to this production path.
SENTINEL_OTLP_ENABLED=false
# Supported values: http, grpc
SENTINEL_OTLP_PROTOCOL=http
# HTTP/protobuf default: http://127.0.0.1:4318/v1/traces
# gRPC default:         http://127.0.0.1:4317
# SENTINEL_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
SENTINEL_OTLP_SERVICE_NAME=sentinel-daemon
SENTINEL_OTLP_TIMEOUT_MS=3000
SENTINEL_OTLP_BATCH_MS=5000
