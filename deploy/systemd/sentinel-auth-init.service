[Unit]
Description=Sentinel Runtime and Credential Initialization
Documentation=https://github.com/silentspike/project-sentinel/issues/650
Before=sentinel-daemon.service sentinel-gateway.service sentinel-dashboard-backend.service sentinel-nightrun.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ConfigurationDirectory=sentinel
ConfigurationDirectoryMode=0755
ExecStart=/usr/bin/python3 /opt/sentinel/scripts/init-m0-runtime-dirs.py
ExecStart=/opt/sentinel/scripts/init-dashboard-auth.sh
ExecStart=/opt/sentinel/scripts/init-company-workflow-auth.sh
RemainAfterExit=yes

# The root-owned initializer is the sole migration writer for the dashboard
# environment, operator credential, and workflow credentials. Consumers receive
# only systemd copies.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/sentinel/config /opt/sentinel/data /etc/sentinel
PrivateTmp=true

[Install]
WantedBy=sentinel.target
