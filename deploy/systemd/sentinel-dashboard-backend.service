[Unit]
Description=Sentinel Dashboard-Backend — axum HTTPS + WebTransport/QUIC, topic+msgpack+zstd (#431)
Documentation=https://github.com/silentspike/project-sentinel/issues/431
After=network-online.target sentinel-auth-init.service
Wants=network-online.target
Requires=sentinel-auth-init.service
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/sentinel
ExecStartPre=/usr/bin/test -x /usr/bin/bwrap
ExecStart=/opt/sentinel/bin/sentinel-dashboard-backend
# The env file retains only the independent dashboard login key and rate-limit knobs;
# the daemon operator proxy credential is file-only. See docs/security/dashboard-key-management.md (#474).
EnvironmentFile=/opt/sentinel/config/dashboard-backend.env
LoadCredential=operator-api:/etc/sentinel/credentials/operator-api
Environment=SENTINEL_OPERATOR_API_KEY_FILE=%d/operator-api
# #474: loopback-only secure default. On-VM access is full (incl. WebTransport); an `ssh -L`
# tunnel is HTTP-only (WT/QUIC = UDP does not traverse a TCP tunnel; full remote console: #522).
# Deliberate LAN/third-party exposure: override SENTINEL_DASHBOARD_*_BIND via the env-file above;
# the TLS/exposure model for that case is defined in #473. Do NOT re-add a 0.0.0.0 bind here.
Environment=SENTINEL_DASHBOARD_HTTP_BIND=127.0.0.1:8001
Environment=SENTINEL_DASHBOARD_WT_BIND=127.0.0.1:8001
Environment=SENTINEL_OPERATOR_API_URL=http://127.0.0.1:8084
Environment=CORTEX_GATEWAY_CONTROL_URL=http://127.0.0.1:8081
Environment=CORTEX_GATEWAY_PROXY_URL=http://127.0.0.1:8080
Environment=SENTINEL_DAEMON_PROMETHEUS_URL=http://127.0.0.1:9090
Environment=SENTINEL_PROJECTION_DB=/opt/sentinel/data/projection.db
Environment=SENTINEL_EVENTS_DB=/opt/sentinel/data/events.db
Environment=SENTINEL_DASHBOARD_BUNDLE_DIR=/opt/sentinel/console-dist
Environment=SENTINEL_DASHBOARD_CERT_DIR=/opt/sentinel/console-cert
Environment=SENTINEL_GAIA_CONSOLE_DIR=/opt/sentinel/data/gaia-console
Environment=SENTINEL_GAIA_CLAUDE_BIN=/opt/sentinel/bin/claude
Environment=SENTINEL_GAIA_COMPANY_CONTEXT=/opt/sentinel/config/company-context.md
Environment=SENTINEL_CTL_BIN=/opt/sentinel/bin/sentinel-ctl
Environment=SENTINEL_GAIA_BIN=/opt/sentinel/bin/sentinel-gaia
Environment=SENTINEL_GAIA_MAX_BUDGET_USD=0.05
Environment=SENTINEL_GAIA_BUDGET_WINDOW_SECS=3600
Environment=SENTINEL_GAIA_BUDGET_WINDOW_USD=0.10
Environment=SENTINEL_GAIA_RATE_LIMIT_REQUESTS=6
Environment=SENTINEL_GAIA_RATE_LIMIT_WINDOW_SECS=60
Environment=SENTINEL_GAIA_SESSION_TIMEOUT_SECS=120
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=5
UMask=0077
KillMode=control-group
TimeoutStopSec=15s
MemoryMax=1536M
TasksMax=96
CPUQuota=200%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sentinel-dashboard-backend

# Security Hardening
NoNewPrivileges=true
ProtectSystem=strict
# Projection-DB nur lesen (Backend oeffnet read-only); Cert-Dir schreiben
# (self-signed beim Start); Gaia Console writes only explicit session streams.
ReadOnlyPaths=/opt/sentinel/data /opt/sentinel/console-dist
ReadWritePaths=/opt/sentinel/console-cert /opt/sentinel/data/gaia-console
PrivateTmp=true

[Install]
WantedBy=sentinel.target
