[Unit]
Description=Sentinel Daemon — ECS Orchestrator
Documentation=https://github.com/silentspike/project-sentinel/issues/94
After=network-online.target nats-server.service sentinel-auth-init.service
Wants=network-online.target
Requires=nats-server.service sentinel-auth-init.service
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=exec
User=root
Group=root
WorkingDirectory=/opt/sentinel
EnvironmentFile=-/etc/sentinel/env
ExecStartPre=/opt/sentinel/bin/sentinel-daemon --config /opt/sentinel/config/daemon.toml initialize-episode-projection
ExecStart=/opt/sentinel/bin/sentinel-daemon --config /opt/sentinel/config/daemon.toml
ExecStartPost=/usr/bin/python3 /opt/sentinel/scripts/m0-readiness.py daemon --credential-file /etc/sentinel/credentials/operator-api --timeout-seconds 120
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=15
MemoryMax=2G
CPUAffinity=0-3
OOMScoreAdjust=-1000
LoadCredential=caller-agent-runtime:/etc/sentinel/credentials/caller-agent-runtime
LoadCredential=caller-platform:/etc/sentinel/credentials/caller-platform
LoadCredential=caller-evolution:/etc/sentinel/credentials/caller-evolution
LoadCredential=operator-api:/etc/sentinel/credentials/operator-api
LoadCredential=workflow-customer:/etc/sentinel/credentials/workflow-customer
LoadCredential=workflow-sales:/etc/sentinel/credentials/workflow-sales
LoadCredential=workflow-project-manager:/etc/sentinel/credentials/workflow-project-manager
LoadCredential=workflow-technical-lead:/etc/sentinel/credentials/workflow-technical-lead
LoadCredential=workflow-designer:/etc/sentinel/credentials/workflow-designer
LoadCredential=workflow-developer:/etc/sentinel/credentials/workflow-developer
LoadCredential=workflow-qa:/etc/sentinel/credentials/workflow-qa
LoadCredential=workflow-release-manager:/etc/sentinel/credentials/workflow-release-manager
Environment=SENTINEL_AGENT_RUNTIME_CREDENTIAL_FILE=%d/caller-agent-runtime
Environment=SENTINEL_PLATFORM_CREDENTIAL_FILE=%d/caller-platform
Environment=SENTINEL_EVOLUTION_CREDENTIAL_FILE=%d/caller-evolution
Environment=SENTINEL_OPERATOR_CREDENTIAL_FILE=%d/operator-api
Environment=SENTINEL_COMPANY_WORKFLOW_ENABLED=true
# Cutover invariant: remain false until the independent hierarchy projection
# has backfilled to the recorded boundary.
Environment=SENTINEL_LLM_USAGE_V2_ENABLED=false

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sentinel-daemon

# Security Hardening
NoNewPrivileges=true
AmbientCapabilities=CAP_SYS_PTRACE
ProtectSystem=strict
# config_dir muss schreibbar sein: der Daemon ist der alleinige config_dir-Schreiber fuer den
# Runtime Config-Apply Write-Back (#425/#420) — sonst ueberlebt eine zur Laufzeit geaenderte
# Firma keinen Restart und driftet von der TOML-SSOT.
ReadWritePaths=/opt/sentinel/data /opt/sentinel/config /opt/sentinel/fs /ram/sentinel /ram/agents
PrivateTmp=true

[Install]
WantedBy=sentinel.target
