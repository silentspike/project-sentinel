[Unit]
Description=Sentinel Daemon — ECS Orchestrator
Documentation=https://github.com/silentspike/project-sentinel/issues/94
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/sentinel
EnvironmentFile=-/etc/sentinel/env
ExecStart=/opt/sentinel/bin/sentinel-daemon --config /opt/sentinel/config/daemon.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
MemoryMax=2G
CPUAffinity=0-3
OOMScoreAdjust=-1000
LoadCredential=caller-agent-runtime:/etc/sentinel/credentials/caller-agent-runtime
LoadCredential=caller-platform:/etc/sentinel/credentials/caller-platform
LoadCredential=caller-evolution:/etc/sentinel/credentials/caller-evolution
Environment=SENTINEL_AGENT_RUNTIME_CREDENTIAL_FILE=%d/caller-agent-runtime
Environment=SENTINEL_PLATFORM_CREDENTIAL_FILE=%d/caller-platform
Environment=SENTINEL_EVOLUTION_CREDENTIAL_FILE=%d/caller-evolution
# Cutover invariant: remain false until the independent hierarchy projection
# has backfilled to the recorded boundary.
Environment=SENTINEL_LLM_USAGE_V2_ENABLED=false

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sentinel-daemon

# Security Hardening
NoNewPrivileges=true
AmbientCapabilities=CAP_SYS_PTRACE
ProtectSystem=strict
# config_dir muss schreibbar sein: der Daemon ist der alleinige config_dir-Schreiber fuer den
# Runtime Config-Apply Write-Back (#425/#420) — sonst ueberlebt eine zur Laufzeit geaenderte
# Firma keinen Restart und driftet von der TOML-SSOT.
ReadWritePaths=/opt/sentinel/data /opt/sentinel/config /opt/sentinel/fs /ram/sentinel /ram/agents
PrivateTmp=true

[Install]
WantedBy=sentinel.target
