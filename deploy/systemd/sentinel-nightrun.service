[Unit]
Description=Sentinel Nightrun — Schichtwechsel-Konsolidierung
Documentation=https://github.com/silentspike/project-sentinel/issues/17
After=sentinel-auth-init.service sentinel-daemon.service
Requires=sentinel-auth-init.service

[Service]
Type=oneshot
WorkingDirectory=/opt/sentinel
ExecCondition=/usr/bin/systemctl --quiet is-active sentinel-daemon.service
LoadCredential=operator-api:/etc/sentinel/credentials/operator-api
# The bounded helper reads the credential from its systemd-owned file. No
# bearer value is exposed through argv or the journal.
ExecStart=/usr/bin/python3 /opt/sentinel/scripts/m0-readiness.py nightrun --credential-name operator-api --timeout-seconds 45
TimeoutStartSec=60
MemoryMax=64M

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sentinel-nightrun

# Security Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/sentinel/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
