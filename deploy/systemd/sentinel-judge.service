[Unit]
Description=Sentinel Judge — Quality Analysis Service (NATS + LLM)
Documentation=https://github.com/silentspike/project-sentinel/issues/26
After=nats-server.service sentinel-daemon.service sentinel-nats-bridge.service sentinel-gateway.service
Requires=nats-server.service sentinel-daemon.service
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
WorkingDirectory=/opt/sentinel
ExecStart=/opt/sentinel/bin/sentinel-judge
Restart=on-failure
RestartSec=5
MemoryMax=512M
Environment=SENTINEL_JUDGE_CONFIG=/opt/sentinel/config/judge.toml
LoadCredential=caller-judge:/etc/sentinel/credentials/caller-judge
Environment=SENTINEL_JUDGE_CREDENTIAL_FILE=%d/caller-judge

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sentinel-judge

# Security Hardening
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/opt/sentinel/data

[Install]
WantedBy=sentinel.target
