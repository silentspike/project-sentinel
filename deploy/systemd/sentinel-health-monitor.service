[Unit]
Description=Sentinel Health Monitor — Service Health Check
Documentation=https://github.com/silentspike/project-sentinel
After=nats-server.service sentinel-daemon.service sentinel-projection.service sentinel-gateway.service sentinel-dashboard-backend.service sentinel-nats-bridge.service sentinel-judge.service

[Service]
Type=oneshot
ExecStart=/opt/sentinel/scripts/sentinel-health-monitor.sh
TimeoutStartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sentinel-health-monitor
ReadWritePaths=/opt/sentinel/data /work/tmp/project-sentinel
