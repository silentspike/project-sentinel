# syntax=docker/dockerfile:1.7
#
# Sentinel Demo image — packages every binary the 10-minute demo needs into
# a single ~200 MB runtime layer.
#
# Pre-requisite (Rust binaries are built OUTSIDE Docker via cargo remote):
#   make demo-binaries
# which is equivalent to:
#   cargo remote -c -- build --release --bin sentinel-daemon --bin sentinel-nightrun
#
# Then build the image:
#   docker build -f deploy/docker/Dockerfile.demo -t sentinel-demo:local .
#
# Why no in-container Rust build:
#   The Sentinel Rust workspace has 15+ crates and links bevy_ecs / zenoh /
#   redb / wasmtime. A from-scratch in-container `cargo build --release` needs
#   8+ GB RAM and 30+ min on a developer laptop, and frequently OOM-kills.
#   The project standard is to use cargo remote against a dedicated build
#   server (.cargo-remote.toml). The Dockerfile honors that: Rust binaries
#   come from `target/release/` on the host, the image just packages them.
#
# The image bundles:
#   - sentinel-daemon (Rust)         operator API on :8084
#   - sentinel-nightrun (Rust)       one-shot batch
#   - cortex-gateway  (Go)           proxy on :8080, control on :8081, metrics on :9090
#   - sentinel-judge  (Go)           health on :8082
#   - sentinel-nats-bridge (Go)      health on :8083
#   - sentinel-dashboard (Bun)       UI on :8000
#
# An entrypoint script (`/usr/local/bin/sentinel-demo-entrypoint`) selects
# which binary to run based on the `SENTINEL_ROLE` environment variable.

# ---------------------------------------------------------------------------
# Stage 1: Rust binary collector — copies pre-built binaries from host
# ---------------------------------------------------------------------------
# This is intentionally NOT a Rust build. The host is expected to have run
# `make demo-binaries` (cargo remote -c -- build --release ...) first.
FROM debian:bookworm-slim AS rust-binaries

COPY target/release/sentinel-daemon   /out/sentinel-daemon
COPY target/release/sentinel-nightrun /out/sentinel-nightrun
RUN chmod +x /out/sentinel-daemon /out/sentinel-nightrun

# ---------------------------------------------------------------------------
# Stage 2: Go build (gateway + judge + nats-bridge)
# ---------------------------------------------------------------------------
FROM golang:1.26-bookworm AS go-builder

WORKDIR /src

COPY go.work go.work.sum* ./
COPY pkg/sentinel-go/ pkg/sentinel-go/
COPY cmd/cortex-gateway/ cmd/cortex-gateway/
COPY services/sentinel-judge/ services/sentinel-judge/
COPY services/sentinel-nats-bridge/ services/sentinel-nats-bridge/

ENV CGO_ENABLED=0 GOOS=linux GOTOOLCHAIN=auto

RUN go build -trimpath -ldflags="-s -w" \
        -o /out/cortex-gateway ./cmd/cortex-gateway && \
    go build -trimpath -ldflags="-s -w" \
        -o /out/sentinel-judge ./services/sentinel-judge && \
    go build -trimpath -ldflags="-s -w" \
        -o /out/sentinel-nats-bridge ./services/sentinel-nats-bridge

# ---------------------------------------------------------------------------
# Stage 3: Bun (dashboard) — fetch deps + sanity-check TypeScript
# ---------------------------------------------------------------------------
FROM oven/bun:1 AS bun-builder

WORKDIR /src/dashboard
COPY dashboard/package.json dashboard/bun.lock ./
RUN bun install --frozen-lockfile

COPY dashboard/ ./
RUN bun run typecheck

# ---------------------------------------------------------------------------
# Stage 4: Runtime — debian-slim with all binaries + Bun runtime
# ---------------------------------------------------------------------------
FROM debian:bookworm-slim AS runtime

ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl libssl3 libfuse3-3 libcap2 \
        unzip xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Bun runtime for the dashboard
RUN curl -fsSL https://bun.sh/install | bash -s "bun-v1.1.30" && \
    mv /root/.bun/bin/bun /usr/local/bin/bun && \
    chmod +x /usr/local/bin/bun

# Service binaries
COPY --from=rust-binaries /out/sentinel-daemon          /usr/local/bin/
COPY --from=rust-binaries /out/sentinel-nightrun        /usr/local/bin/
COPY --from=go-builder    /out/cortex-gateway           /usr/local/bin/
COPY --from=go-builder    /out/sentinel-judge           /usr/local/bin/
COPY --from=go-builder    /out/sentinel-nats-bridge     /usr/local/bin/

# Dashboard runtime tree (with node_modules)
COPY --from=bun-builder  /src/dashboard /opt/sentinel/dashboard

# Configuration tree (overridden via volume in compose)
COPY config/ /opt/sentinel/config-default/

# Demo overrides — small office, fast tick, 10 min cap
COPY config/demo/ /opt/sentinel/config-demo/

# Entrypoint dispatcher
COPY deploy/docker/sentinel-demo-entrypoint.sh /usr/local/bin/sentinel-demo-entrypoint
RUN chmod +x /usr/local/bin/sentinel-demo-entrypoint

# Writable runtime dirs (avoid bash brace-expansion: debian-slim has dash)
RUN mkdir -p /opt/sentinel/data /opt/sentinel/fs /opt/sentinel/logs && \
    useradd -r -u 65001 -d /opt/sentinel sentinel && \
    chown -R sentinel:sentinel /opt/sentinel

USER sentinel
WORKDIR /opt/sentinel

ENV SENTINEL_CONFIG_DIR=/opt/sentinel/config-default \
    SENTINEL_DEMO_CONFIG_DIR=/opt/sentinel/config-demo \
    SENTINEL_DATA_DIR=/opt/sentinel/data \
    PATH=/usr/local/bin:$PATH

ENTRYPOINT ["/usr/local/bin/sentinel-demo-entrypoint"]
CMD ["help"]
