crates/sentinel-wasm/tests/fixtures/**/target/

# Playwright CLI session files
.playwright-cli/

# Stray Go binaries (root-level)
/sentinel-nats-bridge
/cortex-gateway

# Docs (selectively gitignored — public-facing docs are tracked)
# Internal-only doc artefacts that should not appear in Git.
# docs/images/ is gitignored except for the public-facing demo GIF; don't
# add the directory itself, just specific files inside it.
docs/images/*
!docs/images/sentinel-demo.gif
!docs/images/opengraph-preview.png
docs/screenshots/
docs/user-testing-report.md
/AGENTS.md
/test-288-verification.md
/hooks/

